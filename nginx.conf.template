# ABOUTME: nginx template (envsubst at container start) serving the camera
# ABOUTME: page, proxying go2rtc under /go2rtc/, and relaying PrusaLink stats.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    location / {
        root  /usr/share/nginx/html;
        index index.html;
    }

    location /go2rtc/ {
        # Resolve go2rtc via Docker DNS at request time (a variable in
        # proxy_pass defers resolution), so nginx starts without the upstream
        # and survives the go2rtc container changing IP.
        resolver 127.0.0.11 valid=30s;
        set $go2rtc_upstream go2rtc;
        rewrite ^/go2rtc(/.*)$ $1 break;
        proxy_pass http://$go2rtc_upstream:1984;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 1d;
    }

    # Read-only PrusaLink relay: exact paths, GET only, API key injected
    # server-side so it never reaches browsers.
    location = /printer/status {
        limit_except GET { deny all; }
        proxy_pass http://${PRUSALINK_HOST}/api/v1/status;
        proxy_set_header X-Api-Key "${PRUSALINK_API_KEY}";
    }

    location = /printer/job {
        limit_except GET { deny all; }
        proxy_pass http://${PRUSALINK_HOST}/api/v1/job;
        proxy_set_header X-Api-Key "${PRUSALINK_API_KEY}";
    }
}
