# ABOUTME: Config template for the printer-streamer stack; copy to .env and edit.
# ABOUTME: Compose substitutes these into docker-compose.yml at up time.

# RTSP URL of the printer camera
CAMERA_RTSP_URL=rtsp://192.168.1.10/live

# Host port for the webpage
WEB_PORT=8080

# LAN IP of the machine running this stack. Advertised to browsers as the
# WebRTC candidate; if unset or wrong, playback falls back to MSE (works fine,
# slightly higher latency).
WEBRTC_HOST_IP=

# Cloudflare Tunnel token from the Zero Trust dashboard.
# Only needed for `make tunnel-up`. See the README's Cloudflare Tunnel section.
CF_TUNNEL_TOKEN=

# PrusaLink (the printer's own web interface — a different LAN address than
# the camera) for the header stats line. Both values are in the printer's
# Settings -> Network -> PrusaLink. Leave unset to run without stats.
PRUSALINK_HOST=
PRUSALINK_API_KEY=
